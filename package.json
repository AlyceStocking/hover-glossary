{
  "name": "hover-glossary",
  "version": "1.1.0",
  "description": "DSH 客户端插件: 光标停在对话正文的词上, 显示该词的 1..N 条联想",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "scripts",
    "plugin",
    "cordis.patch.yml",
    "README.md",
    "DEVELOPMENT.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "node test/run.mjs",
    "test:browser": "node test/browser.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AlyceStocking/hover-glossary.git"
  },
  "homepage": "https://github.com/AlyceStocking/hover-glossary#readme",
  "bugs": {
    "url": "https://github.com/AlyceStocking/hover-glossary/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "hover-glossary"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
