{
  "name": "hover-glossary",
  "version": "1.1.0",
  "private": true,
  "description": "DSH 客户端插件: 光标停在对话正文的词上, 显示该词的 1..N 条联想",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "scripts",
    "plugin",
    "cordis.patch.yml",
    "README.md",
    "DEVELOPMENT.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "node test/run.mjs",
    "test:browser": "node test/browser.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
